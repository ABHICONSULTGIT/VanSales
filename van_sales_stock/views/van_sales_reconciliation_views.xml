<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="van_sales_reconciliation_view_form" model="ir.ui.view">
        <field name="name">van.sales.reconciliation.form</field>
        <field name="model">van.sales.reconciliation</field>
        <field name="arch" type="xml">
            <form string="Van Reconciliation">
                <header>
                    <button name="action_generate_lines" type="object"
                            string="Refresh System Quantities"
                            invisible="state != 'draft'"/>
                    <button name="action_apply" type="object"
                            string="Apply Count" class="btn-primary"
                            groups="van_sales_base.group_van_sales_manager"
                            invisible="state != 'draft'"
                            confirm="Correct the van's stock to the counted quantities?"/>
                    <button name="action_create_return_picking" type="object"
                            string="Return to Warehouse" class="btn-primary"
                            groups="van_sales_base.group_van_sales_manager"
                            invisible="state != 'done' or return_picking_id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <span class="o_stat_text">Van Movements</span>
                        </button>
                        <button name="action_view_return_picking" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not return_picking_id">
                            <span class="o_stat_text">Return Transfer</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="van_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="van_location_id"/>
                            <field name="salesman_user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="user_id" widget="many2one_avatar_user"
                                   readonly="state != 'draft'"/>
                            <field name="return_picking_id" invisible="not return_picking_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Count" name="count">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list string="Count" editable="bottom" create="0"
                                      decoration-danger="difference_qty &lt; 0"
                                      decoration-warning="difference_qty &gt; 0">
                                    <field name="product_id" readonly="1"/>
                                    <field name="product_uom_id" string="Unit"/>
                                    <field name="expected_qty"/>
                                    <field name="counted_qty"/>
                                    <field name="difference_qty"/>
                                    <field name="company_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Anything worth knowing about this count"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="van_sales_reconciliation_view_list" model="ir.ui.view">
        <field name="name">van.sales.reconciliation.list</field>
        <field name="model">van.sales.reconciliation</field>
        <field name="arch" type="xml">
            <list string="Van Reconciliations"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="van_id"/>
                <field name="salesman_user_id" widget="many2one_avatar_user"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="van_sales_reconciliation_view_search" model="ir.ui.view">
        <field name="name">van.sales.reconciliation.search</field>
        <field name="model">van.sales.reconciliation</field>
        <field name="arch" type="xml">
            <search string="Van Reconciliations">
                <field name="name"/>
                <field name="van_id"/>
                <field name="salesman_user_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="done" string="Applied" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_by_van" string="Van"
                            context="{'group_by': 'van_id'}"/>
                    <filter name="group_by_date" string="Date"
                            context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="van_sales_reconciliation_action" model="ir.actions.act_window">
        <field name="name">Van Reconciliations</field>
        <field name="res_model">van.sales.reconciliation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="van_sales_reconciliation_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Count a van
            </p>
            <p>
                Start one from the van with Reconcile Stock. Each line shows
                what Odoo thinks is on the van; type what you actually counted,
                apply, and Odoo is corrected. Then return the stock to the
                warehouse with one click.
            </p>
        </field>
    </record>

</odoo>
