<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Load, return and count - on the Sales Van form only. -->
    <record id="van_sales_van_view_form_stock" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.van.sales.stock</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="van_sales_base.van_sales_van_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_van_sales_load" type="object"
                            string="Load Van" class="btn-primary"
                            groups="van_sales_base.group_van_sales_manager"
                            invisible="not van_location_id"/>
                    <button name="action_van_sales_unload" type="object"
                            string="Return Stock"
                            groups="van_sales_base.group_van_sales_manager"
                            invisible="not van_location_id"/>
                    <button name="action_van_sales_new_reconciliation"
                            type="object" string="Reconcile Stock"
                            groups="van_sales_base.group_van_sales_supervisor"
                            invisible="not van_location_id"/>
                </header>
            </xpath>
        </field>
    </record>

</odoo>
