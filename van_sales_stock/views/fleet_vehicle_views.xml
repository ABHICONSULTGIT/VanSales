<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fleet_vehicle_view_form_van_sales_stock" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.van.sales.stock</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="van_sales_base.fleet_vehicle_view_form_van_sales"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_van_sales_view_pickings" type="object"
                        class="oe_stat_button" icon="fa-exchange"
                        invisible="not is_sales_van">
                    <field name="van_picking_count" widget="statinfo"
                           string="Transfers"/>
                </button>
                <button name="action_van_sales_view_reconciliations"
                        type="object" class="oe_stat_button" icon="fa-balance-scale"
                        invisible="not is_sales_van">
                    <field name="van_reconciliation_count" widget="statinfo"
                           string="Reconciliations"/>
                </button>
            </xpath>

            <xpath expr="//page[@name='van_sales']/group" position="before">
                <div class="d-flex gap-2 mb-3">
                    <button name="action_van_sales_load" type="object"
                            string="Load Van" class="btn btn-primary"
                            groups="van_sales_base.group_van_sales_manager"
                            invisible="not van_location_id"/>
                    <button name="action_van_sales_unload" type="object"
                            string="Return Stock" class="btn btn-secondary"
                            groups="van_sales_base.group_van_sales_manager"
                            invisible="not van_location_id"/>
                    <button name="action_van_sales_new_reconciliation"
                            type="object" string="Reconcile Stock"
                            class="btn btn-secondary"
                            groups="van_sales_base.group_van_sales_supervisor"
                            invisible="not van_location_id"/>
                </div>
                <field name="van_pending_picking_count" invisible="1"/>
                <div class="alert alert-info" role="alert"
                     invisible="van_pending_picking_count == 0">
                    This van has
                    <field name="van_pending_picking_count" class="oe_inline fw-bold"/>
                    transfer(s) not yet validated.
                </div>
            </xpath>

        </field>
    </record>

</odoo>
