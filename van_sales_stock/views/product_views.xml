<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_category_form_view_van_sales" model="ir.ui.view">
        <field name="name">product.category.form.van.sales</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="van_sale_stock_policy"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_van_sales" model="ir.ui.view">
        <field name="name">product.template.form.van.sales</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="Van Sales" name="van_sales"
                       invisible="not is_storable">
                    <!-- is_storable is contributed by stock's own inherited
                         view; declaring it here guarantees it is present in
                         the combined arch that evaluates the modifier. -->
                    <field name="is_storable" invisible="1"/>
                    <field name="van_sale_stock_policy"/>
                    <field name="van_sale_stock_policy_effective"
                           invisible="van_sale_stock_policy != 'category'"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
