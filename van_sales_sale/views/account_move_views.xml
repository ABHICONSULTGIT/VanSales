<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_van_sales" model="ir.ui.view">
        <field name="name">account.move.form.van.sales</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="Van Sales" name="van_sales"
                       invisible="not van_id">
                    <field name="van_id" readonly="1"/>
                    <field name="van_route_id" readonly="1"/>
                    <field name="van_visit_id" readonly="1"/>
                    <field name="van_salesman_user_id" readonly="1"
                           widget="many2one_avatar_user"/>
                    <field name="van_captured_datetime" readonly="1"
                           invisible="not van_captured_datetime"/>
                    <field name="van_client_uuid" readonly="1"
                           invisible="not van_client_uuid"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="van_sales_invoice_action" model="ir.actions.act_window">
        <field name="name">Van Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('van_id', '!=', False), ('move_type', 'in', ('out_invoice', 'out_refund'))]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No van invoices yet
            </p>
            <p>
                Invoices raised against orders sold from a van.
            </p>
        </field>
    </record>

</odoo>
