<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The Sale Order column and a Sell button on every visit line. -->
    <record id="van_sales_visit_plan_view_form_sale" model="ir.ui.view">
        <field name="name">van.sales.visit.plan.form.sale</field>
        <field name="model">van.sales.visit.plan</field>
        <field name="inherit_id" ref="van_sales_base.van_sales_visit_plan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='visit_ids']/list/field[@name='stop_location_id']"
                   position="after">
                <field name="sale_order_id" readonly="1"/>
                <button name="action_van_sales_new_order" type="object"
                        string="Sell" icon="fa-shopping-cart"
                        invisible="sale_order_id"/>
            </xpath>
        </field>
    </record>

    <record id="van_sales_visit_view_list_sale" model="ir.ui.view">
        <field name="name">van.sales.visit.list.sale</field>
        <field name="model">van.sales.visit</field>
        <field name="inherit_id" ref="van_sales_base.van_sales_visit_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stop_location_id']" position="after">
                <field name="sale_order_id"/>
            </xpath>
        </field>
    </record>

</odoo>
