<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_van_sales" model="ir.ui.view">
        <field name="name">sale.order.form.van.sales</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='order_details']" position="inside">
                <field name="van_id" options="{'no_create': True}"
                       readonly="state in ('sale', 'cancel')"/>
                <field name="van_route_id" options="{'no_create': True}"
                       invisible="not van_id" readonly="state in ('sale', 'cancel')"/>
                <field name="van_visit_id" options="{'no_create': True}"
                       invisible="not van_visit_id" readonly="1"/>
                <field name="van_delivery_route_id"
                       invisible="not van_id" readonly="1"/>
                <field name="van_captured_datetime"
                       invisible="not van_captured_datetime" readonly="1"/>
                <field name="van_client_uuid"
                       invisible="not van_client_uuid" readonly="1"/>
            </xpath>

            <xpath expr="//group[@name='order_details']" position="before">
                <field name="van_credit_warning" invisible="1"/>
                <div class="alert alert-warning" role="alert"
                     invisible="not van_credit_warning">
                    <field name="van_credit_warning" readonly="1" nolabel="1"/>
                </div>
            </xpath>

        </field>
    </record>

    <record id="view_quotation_tree_van_sales" model="ir.ui.view">
        <field name="name">sale.order.list.van.sales</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="van_id" optional="hide"/>
                <field name="van_salesman_user_id" optional="hide"
                       widget="many2one_avatar_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_van_sales" model="ir.ui.view">
        <field name="name">sale.order.search.van.sales</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="van_id"/>
                <filter name="van_sales_orders" string="Van Orders"
                        domain="[('van_id', '!=', False)]"/>
                <filter name="van_sales_group_by_van" string="Van"
                        context="{'group_by': 'van_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="van_sales_order_action" model="ir.actions.act_window">
        <field name="name">Van Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('van_id', '!=', False)]</field>
        <field name="context">{'search_default_van_sales_group_by_van': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No van orders yet
            </p>
            <p>
                Orders raised from a customer visit. They ship from the van's
                own stock rather than the warehouse.
            </p>
        </field>
    </record>

</odoo>
