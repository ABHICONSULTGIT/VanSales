<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_van_sales" model="ir.ui.view">
        <field name="name">res.config.settings.form.van.sales</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_use_credit_limit']" position="after">
                <div class="mt-2" invisible="not account_use_credit_limit">
                    <label for="van_sale_credit_policy" string="Van orders past the limit"/>
                    <field name="van_sale_credit_policy" class="w-auto"/>
                    <div class="text-muted">
                        Odoo itself only warns. Choose Block to stop a van order
                        confirming when the customer is over their limit.
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
