<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="van_sales_visit_plan_view_form" model="ir.ui.view">
        <field name="name">van.sales.visit.plan.form</field>
        <field name="model">van.sales.visit.plan</field>
        <field name="arch" type="xml">
            <form string="Visit Plan">
                <header>
                    <button name="action_generate_visits" type="object"
                            string="Load Route Stops"
                            invisible="not route_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"
                                   placeholder="Set the salesman and date"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="salesman_user_id"
                                   widget="many2one_avatar_user"
                                   options="{'no_create': True}"/>
                            <field name="van_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="route_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Visits" name="visits">
                            <field name="visit_ids">
                                <list string="Visits" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id"/>
                                    <field name="stop_location_id"
                                           column_invisible="not parent.route_id"/>
                                    <field name="company_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="van_sales_visit_plan_view_list" model="ir.ui.view">
        <field name="name">van.sales.visit.plan.list</field>
        <field name="model">van.sales.visit.plan</field>
        <field name="arch" type="xml">
            <list string="Visit Plans">
                <field name="date"/>
                <field name="salesman_user_id" widget="many2one_avatar_user"/>
                <field name="van_id" optional="show"/>
                <field name="route_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="van_sales_visit_plan_view_search" model="ir.ui.view">
        <field name="name">van.sales.visit.plan.search</field>
        <field name="model">van.sales.visit.plan</field>
        <field name="arch" type="xml">
            <search string="Visit Plans">
                <field name="salesman_user_id"/>
                <field name="van_id"/>
                <field name="route_id"/>
                <field name="visit_ids" string="Customer"
                       filter_domain="[('visit_ids.partner_id', 'ilike', self)]"/>
                <filter name="my_plans" string="My Plans"
                        domain="[('salesman_user_id', '=', uid)]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="without_route" string="No Route"
                        domain="[('route_id', '=', False)]"/>
                <group>
                    <filter name="group_by_date" string="Date"
                            context="{'group_by': 'date'}"/>
                    <filter name="group_by_salesman" string="Salesman"
                            context="{'group_by': 'salesman_user_id'}"/>
                    <filter name="group_by_route" string="Route"
                            context="{'group_by': 'route_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="van_sales_visit_plan_action" model="ir.actions.act_window">
        <field name="name">Visit Plans</field>
        <field name="res_model">van.sales.visit.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="van_sales_visit_plan_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No visit plans yet
            </p>
            <p>
                A plan is one salesman's day. It is created automatically the
                first time he raises a sale order on a date, and every sale he
                makes that day is added to it. Create one in advance to give him
                a route as a checklist.
            </p>
        </field>
    </record>

</odoo>
