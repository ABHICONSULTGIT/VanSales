<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="van_sales_stop_location_view_form" model="ir.ui.view">
        <field name="name">van.sales.stop.location.form</field>
        <field name="model">van.sales.stop.location</field>
        <field name="arch" type="xml">
            <form string="Stop Location">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_visits" type="object"
                                class="oe_stat_button" icon="fa-map-marker">
                            <field name="visit_count" widget="statinfo" string="Visits"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. Industrial Area Labour Camp 3"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="code" placeholder="e.g. LC-03"/>
                            <field name="street"/>
                            <field name="city"/>
                        </group>
                        <group>
                            <field name="latitude" digits="[10, 7]"/>
                            <field name="longitude" digits="[10, 7]"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="route_count"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"
                               placeholder="Access, parking, best selling hours, who to speak to..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="van_sales_stop_location_view_list" model="ir.ui.view">
        <field name="name">van.sales.stop.location.list</field>
        <field name="model">van.sales.stop.location</field>
        <field name="arch" type="xml">
            <list string="Stop Locations">
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="city" optional="show"/>
                <field name="street" optional="hide"/>
                <field name="route_count" string="On Routes"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="van_sales_stop_location_view_search" model="ir.ui.view">
        <field name="name">van.sales.stop.location.search</field>
        <field name="model">van.sales.stop.location</field>
        <field name="arch" type="xml">
            <search string="Stop Locations">
                <field name="name" string="Stop"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('city', 'ilike', self)]"/>
                <field name="city"/>
                <filter name="unused" string="Not On Any Route"
                        domain="[('route_line_ids', '=', False)]"/>
                <separator/>
                <filter name="inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_city" string="City"
                            context="{'group_by': 'city'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="van_sales_stop_location_action" model="ir.actions.act_window">
        <field name="name">Stop Locations</field>
        <field name="res_model">van.sales.stop.location</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="van_sales_stop_location_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add the places your vans sell from
            </p>
            <p>
                A stop location is a public place - a market, a labour camp, a
                busy junction - where the van parks and sells to whoever walks
                up. Use these on Location Routes; use customers on Customer
                Routes.
            </p>
        </field>
    </record>

</odoo>
