<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Visits are edited inside their visit plan. This read-only list exists
        only for the "Visits" button on a stop location.
    -->
    <record id="van_sales_visit_view_list" model="ir.ui.view">
        <field name="name">van.sales.visit.list</field>
        <field name="model">van.sales.visit</field>
        <field name="arch" type="xml">
            <list string="Visits" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="salesman_user_id" widget="many2one_avatar_user"/>
                <field name="partner_id"/>
                <field name="stop_location_id"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

</odoo>
