<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="van_sales_route_view_form" model="ir.ui.view">
        <field name="name">van.sales.route.form</field>
        <field name="model">van.sales.route</field>
        <field name="arch" type="xml">
            <form string="Route">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_visit_plans" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <span class="o_stat_text">Visit Plans</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. North Round"/>
                        </h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <notebook>
                        <page string="Stops" name="stops">
                            <field name="line_ids">
                                <list string="Stops" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id"/>
                                    <field name="stop_location_id"/>
                                    <field name="instruction"/>
                                    <field name="company_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="van_sales_route_view_list" model="ir.ui.view">
        <field name="name">van.sales.route.list</field>
        <field name="model">van.sales.route</field>
        <field name="arch" type="xml">
            <list string="Routes">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="van_sales_route_view_search" model="ir.ui.view">
        <field name="name">van.sales.route.search</field>
        <field name="model">van.sales.route</field>
        <field name="arch" type="xml">
            <search string="Routes">
                <field name="name"/>
                <field name="line_ids" string="Customer"
                       filter_domain="[('line_ids.partner_id', 'ilike', self)]"/>
                <field name="line_ids" string="Stop Location"
                       filter_domain="[('line_ids.stop_location_id', 'ilike', self)]"/>
                <separator/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="van_sales_route_action" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">van.sales.route</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="van_sales_route_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define a route
            </p>
            <p>
                A route is a list of stops - customers, stop locations, or a
                customer at a stop location. Give it to a salesman on his visit
                plan for the day as a checklist. It never stops him selling
                anywhere else.
            </p>
        </field>
    </record>

</odoo>
