<odoo>

    <record id="view_vat_report_config_form" model="ir.ui.view">
        <field name="name">vat.report.config.form</field>
        <field name="model">vat.report.config</field>
        <field name="arch" type="xml">
            <form string="VAT Reporting API Settings">
                <group>
                    <field name="api_base_url" placeholder="http://20.244.85.207:9005"/>
                    <field name="api_token" placeholder="VINNO-CA-11"/>
                </group>
                <footer>
                    <button name="action_save" type="object" string="Save" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vat_report_config" model="ir.actions.act_window">
        <field name="name">API Settings</field>
        <field name="res_model">vat.report.config</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
