<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="van_sales_sync_log_view_list" model="ir.ui.view">
        <field name="name">van.sales.sync.log.list</field>
        <field name="model">van.sales.sync.log</field>
        <field name="arch" type="xml">
            <list string="Sync Log" create="false"
                  decoration-danger="status == 'error'"
                  decoration-warning="status == 'rejected'"
                  decoration-muted="status == 'duplicate'">
                <field name="create_date" string="Received"/>
                <field name="res_model" string="Model"/>
                <field name="record_ref" string="Record"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'error'"
                       decoration-warning="status == 'rejected'"/>
                <field name="error_code" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="device_id" optional="show"/>
                <field name="captured_at" optional="hide"/>
                <field name="duration_ms" string="ms" optional="hide"/>
                <field name="client_uuid" optional="hide"/>
                <field name="batch_uuid" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="van_sales_sync_log_view_form" model="ir.ui.view">
        <field name="name">van.sales.sync.log.form</field>
        <field name="model">van.sales.sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log" create="false" edit="false">
                <header>
                    <button name="action_open_record" type="object"
                            string="Open Record" invisible="not res_id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="status"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="record_ref"/>
                            <field name="captured_at"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="device_id"/>
                            <field name="client_uuid"/>
                            <field name="batch_uuid"/>
                            <field name="duration_ms"/>
                        </group>
                    </group>
                    <group string="Outcome" invisible="not error_code">
                        <field name="error_code"/>
                        <field name="error_message"/>
                    </group>
                    <group string="Payload">
                        <field name="payload" widget="text" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="van_sales_sync_log_view_search" model="ir.ui.view">
        <field name="name">van.sales.sync.log.search</field>
        <field name="model">van.sales.sync.log</field>
        <field name="arch" type="xml">
            <search string="Sync Log">
                <field name="client_uuid"/>
                <field name="batch_uuid"/>
                <field name="record_ref"/>
                <field name="user_id"/>
                <field name="device_id"/>
                <filter name="failed" string="Not Accepted"
                        domain="[('status', 'in', ('rejected', 'error'))]"/>
                <filter name="duplicates" string="Duplicates"
                        domain="[('status', '=', 'duplicate')]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('create_date', '>=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group>
                    <filter name="group_by_status" string="Status"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_by_model" string="Model"
                            context="{'group_by': 'res_model'}"/>
                    <filter name="group_by_code" string="Error Code"
                            context="{'group_by': 'error_code'}"/>
                    <filter name="group_by_device" string="Device"
                            context="{'group_by': 'device_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="van_sales_sync_log_action" model="ir.actions.act_window">
        <field name="name">Sync Log</field>
        <field name="res_model">van.sales.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="van_sales_sync_log_view_search"/>
    </record>
</odoo>
