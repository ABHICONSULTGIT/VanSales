<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="van_sales_api_log_view_list" model="ir.ui.view">
        <field name="name">van.sales.api.log.list</field>
        <field name="model">van.sales.api.log</field>
        <field name="arch" type="xml">
            <list string="API Log" create="false"
                  decoration-danger="is_error" decoration-muted="not is_success">
                <field name="request_time"/>
                <field name="method"/>
                <field name="name" string="Endpoint"/>
                <field name="endpoint_group" optional="show"/>
                <field name="http_status"/>
                <field name="duration_ms" string="ms" sum="Total ms"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="device_uuid" optional="hide"/>
                <field name="app_version" optional="hide"/>
                <field name="ip_address" optional="hide"/>
                <field name="error_type" optional="hide"/>
                <field name="is_error" column_invisible="True"/>
                <field name="is_success" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="van_sales_api_log_view_form" model="ir.ui.view">
        <field name="name">van.sales.api.log.form</field>
        <field name="model">van.sales.api.log</field>
        <field name="arch" type="xml">
            <form string="API Log" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="method"/>
                            <field name="http_status"/>
                            <field name="duration_ms"/>
                            <field name="request_time"/>
                            <field name="endpoint_group"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="device_uuid"/>
                            <field name="app_version"/>
                            <field name="ip_address"/>
                            <field name="full_url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request" name="request">
                            <group>
                                <field name="query_params" widget="text"/>
                                <field name="request_headers" widget="text"/>
                                <field name="request_body" widget="text"/>
                            </group>
                        </page>
                        <page string="Response" name="response">
                            <field name="response_body" widget="text"/>
                        </page>
                        <page string="Error" name="error" invisible="not is_error">
                            <field name="is_error" invisible="1"/>
                            <group>
                                <field name="error_type"/>
                                <field name="error_message"/>
                            </group>
                            <field name="traceback" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="van_sales_api_log_view_search" model="ir.ui.view">
        <field name="name">van.sales.api.log.search</field>
        <field name="model">van.sales.api.log</field>
        <field name="arch" type="xml">
            <search string="API Log">
                <field name="name" string="Endpoint"/>
                <field name="user_id"/>
                <field name="device_uuid"/>
                <field name="error_message"/>
                <filter name="errors" string="Errors"
                        domain="[('is_error', '=', True)]"/>
                <filter name="slow" string="Slower than 1s"
                        domain="[('duration_ms', '>', 1000)]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('request_time', '>=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group>
                    <filter name="group_by_endpoint" string="Endpoint"
                            context="{'group_by': 'name'}"/>
                    <filter name="group_by_group" string="Group"
                            context="{'group_by': 'endpoint_group'}"/>
                    <filter name="group_by_status" string="Status"
                            context="{'group_by': 'http_status'}"/>
                    <filter name="group_by_user" string="User"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="van_sales_api_log_action" model="ir.actions.act_window">
        <field name="name">API Log</field>
        <field name="res_model">van.sales.api.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="van_sales_api_log_view_search"/>
        <field name="context">{'search_default_today': 1}</field>
    </record>
</odoo>
