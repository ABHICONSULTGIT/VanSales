<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="van_sales_device_own_rule" model="ir.rule">
        <field name="name">Van Sales Device: own devices only</field>
        <field name="model_id" ref="model_van_sales_device"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('van_sales_base.group_van_sales_user'))]"/>
    </record>
    <record id="van_sales_device_all_rule" model="ir.rule">
        <field name="name">Van Sales Device: all devices</field>
        <field name="model_id" ref="model_van_sales_device"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('van_sales_base.group_van_sales_supervisor'))]"/>
    </record>

    <record id="van_sales_notification_own_rule" model="ir.rule">
        <field name="name">Van Sales Notification: own only</field>
        <field name="model_id" ref="model_van_sales_notification"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('van_sales_base.group_van_sales_user'))]"/>
    </record>
    <record id="van_sales_notification_all_rule" model="ir.rule">
        <field name="name">Van Sales Notification: all</field>
        <field name="model_id" ref="model_van_sales_notification"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('van_sales_base.group_van_sales_supervisor'))]"/>
    </record>

    <record id="van_sales_api_token_own_rule" model="ir.rule">
        <field name="name">Van Sales API Token: own only</field>
        <field name="model_id" ref="model_van_sales_api_token"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('van_sales_base.group_van_sales_user'))]"/>
    </record>

    <record id="van_sales_device_comp_rule" model="ir.rule">
        <field name="name">Van Sales Device: multi-company</field>
        <field name="model_id" ref="model_van_sales_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
